# Environment Variables Template for Examination Center Allotment Portal
# Copy this file to .env.local and fill in your values

# ============================================================
# MongoDB Configuration (Required)
# ============================================================

# Local MongoDB (Default Recommended):
MONGODB_URI=mongodb://127.0.0.1:27017/exam_management

# MongoDB Atlas (Alternative - replace with your cluster URI):
# MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>/exam_management?retryWrites=true&w=majority

# ============================================================
# Admin Authentication (Required)
# ============================================================

ADMIN_EMAIL=admin@examportal.com
ADMIN_PASSWORD=Admin@123

# ============================================================
# Email Configuration (Optional - Gmail SMTP / Resend)
# ============================================================

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# ============================================================
# Application Configuration
# ============================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_EXAM_DATE=2026-03-15
NEXT_PUBLIC_CENTER_NAME=Govt. Central Examination Complex
NEXT_PUBLIC_CENTER_ADDRESS=Frazer Road, Patna - 800001
